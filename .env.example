# ── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ampersand:ampersand@localhost:5432/ampersand
# Sync driver used by Alembic ONLY (psycopg2, not asyncpg)
SYNC_DATABASE_URL=postgresql://ampersand:ampersand@localhost:5432/ampersand

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── Clerk ─────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWT_ISSUER=https://<your-clerk-domain>.clerk.accounts.dev

# ── Next.js public vars (must be prefixed NEXT_PUBLIC_) ───────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/conversation
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/conversation

# ── Backend mode ──────────────────────────────────────────────────────────────
# "mock"  → InMemoryGraphRepo + MockExtractor + MockAuthGate (no DB required)
# "real"  → PostgresGraphRepo + ClaudeExtractor + ClerkAuthGate
AMPERSAND_BACKEND_MODE=mock

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
