# ── Postgres (Supabase) ───────────────────────────────────────────────────────
# Get connection strings from Supabase dashboard → Settings → Database → Session Pooler
# Use port 6543 — port 5432 is blocked on most university networks
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Sync driver used by Alembic ONLY (psycopg2, not asyncpg)
SYNC_DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# ── Supabase JWT ──────────────────────────────────────────────────────────────
# Get from Supabase dashboard → Settings → JWT Keys → Legacy HS256 secret
SUPABASE_JWT_SECRET=...

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── Backend mode ──────────────────────────────────────────────────────────────
# "mock"  → InMemoryGraphRepo + MockExtractor + MockAuthGate (no DB required)
# "real"  → PostgresGraphRepo + ClaudeExtractor + SupabaseAuthGate
AMPERSAND_BACKEND_MODE=mock

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
